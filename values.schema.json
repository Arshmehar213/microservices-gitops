{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "global": {
      "$ref": "#/$defs/global"
    },
    "microservices": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analytics",
        "auth",
        "category",
        "gateway",
        "health",
        "notification",
        "task",
        "user"
      ],
      "properties": {
        "analytics": {
          "$ref": "#/$defs/microservice"
        },
        "auth": {
          "$ref": "#/$defs/microservice"
        },
        "category": {
          "$ref": "#/$defs/microservice"
        },
        "gateway": {
          "$ref": "#/$defs/microservice"
        },
        "health": {
          "$ref": "#/$defs/microservice"
        },
        "notification": {
          "$ref": "#/$defs/microservice"
        },
        "task": {
          "$ref": "#/$defs/microservice"
        },
        "user": {
          "$ref": "#/$defs/microservice"
        }
      }
    },
    "ingress": {
      "$ref": "#/$defs/ingress"
    }
  },
  "$defs": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "partOf": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "required": [
            "pullPolicy"
          ]
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "partOf",
        "image",
        "terminationGracePeriodSeconds"
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "required": [
        "repository",
        "tag"
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "$ref": "#/$defs/resourceQuantities"
        },
        "limits": {
          "$ref": "#/$defs/resourceQuantities"
        }
      },
      "required": [
        "requests",
        "limits"
      ]
    },
    "resourceQuantities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "type": "string",
          "minLength": 1
        },
        "memory": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "cpu",
        "memory"
      ]
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "targetMemoryUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "enabled",
        "minReplicas",
        "maxReplicas",
        "targetCPUUtilizationPercentage",
        "targetMemoryUtilizationPercentage"
      ]
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": [
            "string",
            "integer"
          ]
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "enabled",
        "path",
        "port",
        "initialDelaySeconds",
        "periodSeconds",
        "timeoutSeconds",
        "failureThreshold",
        "successThreshold"
      ]
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup": {
          "$ref": "#/$defs/probe"
        },
        "readiness": {
          "$ref": "#/$defs/probe"
        },
        "liveness": {
          "$ref": "#/$defs/probe"
        }
      },
      "required": [
        "startup",
        "readiness",
        "liveness"
      ]
    },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runAsNonRoot": {
          "type": "boolean"
        },
        "runAsUser": {
          "type": "integer",
          "minimum": 0
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 0
        },
        "fsGroup": {
          "type": "integer",
          "minimum": 0
        },
        "seccompProfile": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "RuntimeDefault",
                "Localhost",
                "Unconfined"
              ]
            },
            "localhostProfile": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ]
        }
      }
    },
    "securityContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowPrivilegeEscalation": {
          "type": "boolean"
        },
        "readOnlyRootFilesystem": {
          "type": "boolean"
        },
        "runAsNonRoot": {
          "type": "boolean"
        },
        "runAsUser": {
          "type": "integer",
          "minimum": 0
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 0
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "add": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "drop": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "create",
        "automountServiceAccountToken",
        "annotations"
      ]
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fromServices": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "fromServices"
          ]
        },
        "fromIngressController": {
          "type": "boolean"
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "toServices": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "toServices"
          ]
        },
        "allowDNS": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "ingress",
        "fromIngressController",
        "egress",
        "allowDNS"
      ]
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^[0-9]+%$"
            }
          ]
        }
      },
      "required": [
        "enabled",
        "minAvailable"
      ]
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "RollingUpdate",
                "Recreate"
              ]
            },
            "rollingUpdate": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "maxUnavailable": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "string",
                      "pattern": "^[0-9]+%$"
                    }
                  ]
                },
                "maxSurge": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "string",
                      "pattern": "^[0-9]+%$"
                    }
                  ]
                }
              }
            }
          },
          "required": [
            "type"
          ]
        },
        "revisionHistoryLimit": {
          "type": "integer",
          "minimum": 0
        },
        "progressDeadlineSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "minReadySeconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "strategy",
        "revisionHistoryLimit",
        "progressDeadlineSeconds",
        "minReadySeconds"
      ]
    },
    "topologySpread": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxSkew": {
          "type": "integer",
          "minimum": 1
        },
        "topologyKey": {
          "type": "string",
          "minLength": 1
        },
        "whenUnsatisfiable": {
          "type": "string",
          "enum": [
            "DoNotSchedule",
            "ScheduleAnyway"
          ]
        }
      },
      "required": [
        "enabled",
        "maxSkew",
        "topologyKey",
        "whenUnsatisfiable"
      ]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer",
            "ExternalName"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "targetPort": {
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "required": [
        "type",
        "port",
        "targetPort"
      ]
    },
    "microservice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "containerPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "service": {
          "$ref": "#/$defs/service"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "autoscaling": {
          "$ref": "#/$defs/autoscaling"
        },
        "config": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "secrets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "existingSecret": {
              "type": "string"
            }
          }
        },
        "probes": {
          "$ref": "#/$defs/probes"
        },
        "podSecurityContext": {
          "$ref": "#/$defs/podSecurityContext"
        },
        "securityContext": {
          "$ref": "#/$defs/securityContext"
        },
        "serviceAccount": {
          "$ref": "#/$defs/serviceAccount"
        },
        "networkPolicy": {
          "$ref": "#/$defs/networkPolicy"
        },
        "podDisruptionBudget": {
          "$ref": "#/$defs/pdb"
        },
        "deployment": {
          "$ref": "#/$defs/deployment"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        },
        "topologySpread": {
          "$ref": "#/$defs/topologySpread"
        }
      },
      "required": [
        "enabled",
        "image",
        "replicaCount",
        "containerPort",
        "service",
        "resources",
        "autoscaling",
        "config",
        "secrets",
        "probes",
        "podSecurityContext",
        "securityContext",
        "serviceAccount",
        "networkPolicy",
        "podDisruptionBudget",
        "deployment",
        "nodeSelector",
        "tolerations",
        "affinity",
        "topologySpread"
      ]
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pathType": {
                      "type": "string",
                      "enum": [
                        "Prefix",
                        "Exact",
                        "ImplementationSpecific"
                      ]
                    },
                    "service": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "port": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 65535
                        }
                      },
                      "required": [
                        "name",
                        "port"
                      ]
                    }
                  },
                  "required": [
                    "path",
                    "pathType",
                    "service"
                  ]
                }
              }
            },
            "required": [
              "host",
              "paths"
            ]
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "secretName": {
                "type": "string",
                "minLength": 1
              },
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "secretName",
              "hosts"
            ]
          }
        }
      },
      "required": [
        "enabled",
        "className",
        "annotations",
        "hosts",
        "tls"
      ]
    }
  }
}